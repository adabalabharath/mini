  @apply grid;
  grid-auto-rows: max-content;
  grid-template-columns: max-content auto max-content;
  grid-template-areas:
    'icon title'
    'icon description'
    'icon action';

  & > [data-uds-child='toast-icon'] {
    grid-area: icon;
    @apply -ml-1 mr-2 rtl:(ml-2 -mr-1);
  }

  & > [data-uds-child='toast-title'] {
    grid-area: title;
    @apply justify-self-start self-start leading-normal;
  }

  & > [data-uds-child='toast-description'] {
    grid-area: description;
    @apply justify-self-start self-start;
  }

  & > [data-uds-child='toast-action'] {
    grid-area: action;
    @apply mt-2 justify-self-start self-start;
  }

  & > [data-uds-child='toast-close'] {
    @apply absolute right-2 top-2 mt-0 z-10 rtl:(-ml-1.5 mr-0 left-3 right-auto);
  }
