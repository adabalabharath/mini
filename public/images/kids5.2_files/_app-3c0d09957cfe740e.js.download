  @apply grid;
  grid-auto-rows: max-content;

  & > [data-uds-child='callout-icon'] {
    grid-area: icon;
    @apply mt-px;
  }

  & > [data-uds-child='callout-body'] {
    grid-area: body;
    @apply justify-self-start self-start leading-normal;
  }

