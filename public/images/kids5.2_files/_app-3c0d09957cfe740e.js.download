  &::before {
    content: '';
    transition: transform 350ms cubic-bezier(0.76, 0, 0.24, 1) 150ms;
    @apply absolute left-0 bottom-0 right-0 h-[2px] bg-current transform scale-x-0 origin-left pointer-none;
  }

  :hover > &::before {
    @apply scale-x-100;
  }

  &::after {
    content: '';
    transition: transform 350ms cubic-bezier(0.76, 0, 0.24, 1);
    @apply absolute left-0 bottom-0 right-0 h-[2px] bg-current transform scale-x-100 origin-right pointer-none;
  }

  :hover > &::after {
    @apply scale-x-0;
  }
